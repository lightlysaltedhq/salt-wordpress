{
    "extends": "stylelint-config-standard",
    "ignoreFiles": [
        "assets/dist/**",
        "node_modules/**",
        "vendor/**",
        "style.css"
    ],
    "rules": {
        "import-notation": "string",
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "theme",
                    "source",
                    "utility",
                    "variant",
                    "custom-variant",
                    "apply",
                    "reference",
                    "plugin",
                    "config"
                ]
            }
        ]
    }
}
